# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/property_db
DB_ECHO=false
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/test_property_db

# ---------------------------------------------------------------------------
# Phase 4 — LLM Provider
# Set LLM_PROVIDER to one of: ollama | lmstudio | openai | anthropic | gemini
# ---------------------------------------------------------------------------
LLM_PROVIDER=lmstudio
LLM_MODEL=google/gemma-3-4b
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# Ollama example:
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5-coder:3b-instruct-q6_K
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama

# OpenAI example:
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...

# Anthropic example:
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Authentication / application
# ---------------------------------------------------------------------------
AUTH_COOKIE_NAME=re_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe_12345!

# ---------------------------------------------------------------------------
# SMTP (optional for local POC; when omitted, verification/reset URLs are logged)
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@lumina-estates.local
